# =============================================================================
# TerraNexus Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# =============================================================================

# Cesium Ion Access Token (required for terrain and premium imagery)
# Get a free token at: https://ion.cesium.com/tokens
VITE_CESIUM_ION_TOKEN=YOUR_CESIUM_ION_TOKEN

# OpenWeatherMap API Key (future: weather layer)
# Get a free key at: https://openweathermap.org/api
VITE_OPENWEATHER_API_KEY=YOUR_OPENWEATHER_API_KEY

# MapTiler API Key (future: alternative map tiles)
# Get a free key at: https://www.maptiler.com/cloud/
VITE_MAPTILER_API_KEY=YOUR_MAPTILER_API_KEY

# Base path for deployment (default: /Atlas-one/)
# Set to '/' for custom domain deployments
# VITE_BASE_PATH=/Atlas-one/
